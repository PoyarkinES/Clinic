# Use the official .NET SDK image as a build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build

WORKDIR /src
EXPOSE 8080
EXPOSE 8081

# Copy the project files into the container
COPY . .

# Restore dependencies for all projects
RUN dotnet restore Servicies/gRPC/Dictionary/src/Service/Country.Api.csproj

# Build the projects
RUN dotnet build Servicies/gRPC/Dictionary/src/Service/Country.Api.csproj -c Release -o /app/Service

# Publish the application
RUN dotnet publish Servicies/gRPC/Dictionary/src/Service/Country.Api.csproj -c Release -o /app/Service

WORKDIR /app

# Copy the published application from the build stage
COPY --from=build /app/Service .

